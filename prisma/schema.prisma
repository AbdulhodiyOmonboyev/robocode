generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  TRIAL_BOOKED
  TRIAL_COMPLETED
  ENROLLED
  POSTPONED
  LOST
}

enum TimePreference {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

enum LeadSource {
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  TIKTOK
  REFERRAL
  WEBSITE
  WALK_IN
  PHONE_CALL
  OTHER
}

enum ReminderStatus {
  PENDING
  DONE
  MISSED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String?  @unique
  phone        String?
  passwordHash String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  avatarUrl    String?

  canManageLeads   Boolean @default(true)
  canManageCourses Boolean @default(false)
  canManageUsers   Boolean @default(false)
  canViewReports   Boolean @default(false)
  canExportData    Boolean @default(false)

  leads        Lead[]     @relation("AssignedTo")
  createdLeads Lead[]     @relation("CreatedBy")
  reminders    Reminder[]
  activities   Activity[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
}

model Course {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  durationMonths Int
  price          Decimal @db.Decimal(10, 2)
  currency       String  @default("UZS")
  isActive       Boolean @default(true)
  color          String?

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeSlot {
  id        String  @id @default(cuid())
  startTime String
  endTime   String
  label     String
  isActive  Boolean @default(true)

  leads Lead[]
}

model Lead {
  id String @id @default(cuid())

  fullName       String
  phone          String
  phoneSecondary String?
  email          String?
  age            Int?
  address        String?

  courseId String?
  course   Course?   @relation(fields: [courseId], references: [id])

  timeSlotId String?
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id])

  timePreference TimePreference @default(FLEXIBLE)
  preferredDays  String?

  status        LeadStatus @default(NEW)
  source        LeadSource @default(OTHER)
  sourceDetails String?

  notes String? @db.Text

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  reminders  Reminder[]
  activities Activity[]
  tags       Tag[]

  trialDate       DateTime?
  enrolledAt      DateTime?
  lastContactedAt DateTime?
  isPinned        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@index([assignedToId])
  @@index([createdAt])
}

model Reminder {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String?

  remindAt DateTime
  status   ReminderStatus @default(PENDING)

  notifyBrowser  Boolean @default(true)
  notifyTelegram Boolean @default(false)
  notifyEmail    Boolean @default(false)

  notifiedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([remindAt])
  @@index([status])
  @@index([userId])
}

model Activity {
  id     String  @id @default(cuid())
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action  String
  details Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#3B82F6")
  leads Lead[]
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}
