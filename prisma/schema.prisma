generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  TRIAL_BOOKED
  TRIAL_COMPLETED
  ENROLLED
  POSTPONED
  LOST
}

enum TimePreference {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

enum LeadSource {
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  TIKTOK
  REFERRAL
  WEBSITE
  WALK_IN
  PHONE_CALL
  OTHER
}

enum ReminderStatus {
  PENDING
  DONE
  MISSED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String?  @unique
  phone        String?
  passwordHash String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  avatarUrl    String?

  salary           Decimal? @db.Decimal(12, 2)
  subject          String?

  canManageLeads   Boolean @default(true)
  canManageCourses Boolean @default(false)
  canManageUsers   Boolean @default(false)
  canViewReports   Boolean @default(false)
  canExportData    Boolean @default(false)

  leads        Lead[]     @relation("AssignedTo")
  createdLeads Lead[]     @relation("CreatedBy")
  reminders    Reminder[]
  activities   Activity[]
  groupsTeaching Group[]  @relation("GroupTeacher")
  paymentsCreated Payment[] @relation("PaymentCreatedBy")
  attendanceMarked Attendance[] @relation("AttendanceBy")
  expensesCreated Expense[] @relation("ExpenseCreatedBy")
  incomesCreated  Income[]  @relation("IncomeCreatedBy")
  salaryRecords   SalaryRecord[] @relation("SalaryUser")
  salaryRecordsCreated SalaryRecord[] @relation("SalaryCreatedBy")
  examsCreated    Exam[]    @relation("ExamCreatedBy")
  coinTxCreated   CoinTx[]  @relation("CoinCreatedBy")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
}

model Course {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String?
  durationMonths Int
  price          Decimal @db.Decimal(10, 2)
  currency       String  @default("UZS")
  isActive       Boolean @default(true)
  color          String?

  leads  Lead[]
  groups Group[]
  exams  Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeSlot {
  id        String  @id @default(cuid())
  startTime String
  endTime   String
  label     String
  isActive  Boolean @default(true)

  leads Lead[]
}

model Lead {
  id String @id @default(cuid())

  fullName       String
  phone          String
  phoneSecondary String?
  email          String?
  age            Int?
  address        String?
  parentName     String?
  parentPhone    String?
  telegramChatId String?
  coins          Int      @default(0)
  frozenAt       DateTime?
  frozenUntil    DateTime?
  referrerName   String?
  referrerPhone  String?
  isArchived     Boolean  @default(false)

  courseId String?
  course   Course?   @relation(fields: [courseId], references: [id])

  timeSlotId String?
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id])

  timePreference TimePreference @default(FLEXIBLE)
  preferredDays  String?
  lessonTime     String?

  stageId String?
  stage   Stage?  @relation(fields: [stageId], references: [id])

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  status        LeadStatus @default(NEW)
  source        LeadSource @default(OTHER)
  sourceDetails String?

  notes String? @db.Text

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  reminders  Reminder[]
  activities Activity[]
  tags       Tag[]
  payments   Payment[]
  attendances Attendance[]
  scores     Score[]
  coinTxs    CoinTx[]

  trialDate       DateTime?
  enrolledAt      DateTime?
  lastContactedAt DateTime?
  isPinned        Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@index([assignedToId])
  @@index([createdAt])
}

model Reminder {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String?

  remindAt DateTime
  status   ReminderStatus @default(PENDING)

  notifyBrowser  Boolean @default(true)
  notifyTelegram Boolean @default(false)
  notifyEmail    Boolean @default(false)

  notifiedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([remindAt])
  @@index([status])
  @@index([userId])
}

model Activity {
  id     String  @id @default(cuid())
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action  String
  details Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#3B82F6")
  leads Lead[]
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

model PaymentType {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("exam")
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  date        DateTime @db.Date
  maxScore    Int      @default(100)
  createdById String
  createdBy   User     @relation("ExamCreatedBy", fields: [createdById], references: [id])
  scores      Score[]
  createdAt   DateTime @default(now())

  @@index([date])
}

model Score {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, leadId])
  @@index([leadId])
}

model CoinTx {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  createdById String
  createdBy   User     @relation("CoinCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([leadId])
}

model Holiday {
  id    String   @id @default(cuid())
  date  DateTime @db.Date @unique
  name  String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Group {
  id        String    @id @default(cuid())
  name      String
  courseId  String?
  course    Course?   @relation(fields: [courseId], references: [id])
  teacherId String?
  teacher   User?     @relation("GroupTeacher", fields: [teacherId], references: [id])
  days      String?
  timeFrom  String?
  timeTo    String?
  room      String?
  startDate DateTime?
  isActive  Boolean   @default(true)
  isArchived Boolean  @default(false)
  leads     Lead[]
  payments  Payment[]
  attendances Attendance[]
  exams     Exam[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Attendance {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  status      String   @default("present")
  note        String?
  createdById String
  createdBy   User     @relation("AttendanceBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupId, leadId, date])
  @@index([groupId, date])
}

model Payment {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  discount    Decimal? @db.Decimal(12, 2)
  currency    String   @default("UZS")
  method      String   @default("cash")
  type        String   @default("tuition")
  forMonth    String?
  note        String?
  paidAt      DateTime @default(now())
  createdById String
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([paidAt])
  @@index([forMonth])
}

model Stage {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  note        String?
  spentAt     DateTime @default(now())
  createdById String
  createdBy   User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([spentAt])
}

model Income {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  source      String
  note        String?
  receivedAt  DateTime @default(now())
  createdById String
  createdBy   User     @relation("IncomeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([receivedAt])
}

model SalaryRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("SalaryUser", fields: [userId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  month       String
  type        String   @default("salary")
  note        String?
  paidAt      DateTime @default(now())
  createdById String
  createdBy   User     @relation("SalaryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([month])
}
